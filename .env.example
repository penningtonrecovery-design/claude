# Copy to .env.local and fill in. Never commit .env.local.
# Anything prefixed NEXT_PUBLIC_ is sent to the browser; everything else stays on the server.

# Public URL of the app (used in emails and redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (database + sign-in) -------------------------------------------
# Local: run `npx supabase start` and copy the values it prints
# ("API URL" and the publishable/anon key; the secret/service_role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used solely to delete a user's account on request.
SUPABASE_SECRET_KEY=

# --- Text conversations (language model) -------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
# Any chat-capable model your OpenAI account can use, e.g. gpt-5.5
OPENAI_MODEL=

# --- Voice conversations (Retell AI) -----------------------------------------
# API key from the Retell dashboard, and the ID of the agent you configured
# with the Fatherly Friend prompt (see docs/RETELL_SETUP.md).
RETELL_API_KEY=
RETELL_AGENT_ID=
